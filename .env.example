# ==============================================================================
# URBANPULSE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=UrbanPulse
APP_VERSION=0.1.0

# Geographic Intelligence Radius & Defaults
DEFAULT_CITY=bengaluru
INTELLIGENCE_RADIUS_KM=50.0
MYSURU_LAT=12.2958
MYSURU_LON=76.6394
BENGALURU_LAT=12.9716
BENGALURU_LON=77.5946

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# Supabase (Auth, Real-time & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://topsnenebefnqrlseliy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BDACpdMx-bhX4oj_XZPJlw_0LJKi9cg
SUPABASE_URL=https://topsnenebefnqrlseliy.supabase.co
SUPABASE_KEY=sb_publishable_BDACpdMx-bhX4oj_XZPJlw_0LJKi9cg

# Database (PostgreSQL with PostGIS)
POSTGRES_USER=urbanpulse_admin
POSTGRES_PASSWORD=urbanpulse_secret
POSTGRES_DB=urbanpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://urbanpulse_admin:urbanpulse_secret@localhost:5432/urbanpulse_db

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Geospatial & Map APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
TOMTOM_API_KEY=your-tomtom-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here
OPENSTREETMAP_NOMINATIM_USER_AGENT=urbanpulse-app

# Weather & Environmental Services (Open-Meteo, AQI)
OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast
AQI_API_KEY=your-aqi-api-key

# AI & LLM Providers (for RAG & Autonomous City Agents)
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
HUGGINGFACE_API_TOKEN=your-huggingface-token
ANTHROPIC_API_KEY=your-anthropic-api-key

# Vector Database (for City Knowledge & Spatial Incident Memory)
CHROMA_PERSIST_DIRECTORY=./ai/rag/chroma_db
QDRANT_HOST=localhost
QDRANT_PORT=6333
